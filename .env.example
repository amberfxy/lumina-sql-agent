# Application
LOG_LEVEL=INFO
# json in production (adds request_id to every line)
LOG_FORMAT=text
MAX_RETRY_ITERATIONS=3
AGENT_DEADLINE_SECONDS=90
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# LLM (set one provider)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=            # optional, for OpenAI-compatible providers
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
# Per try; capped by the remaining agent deadline
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_INPUT_COST_PER_1M_TOKENS=2.50
LLM_OUTPUT_COST_PER_1M_TOKENS=10.00

# Access control and load (all per replica)
# Unset = no authentication
# API_KEYS=key-one,key-two
# Per client; 0 = off
RATE_LIMIT_PER_MINUTE=0
MAX_CONCURRENT_REQUESTS=16
MAX_QUEUED_REQUESTS=32
QUEUE_TIMEOUT_SECONDS=10
# Server-side gate; clients cannot enable writes on their own
MUTATIONS_ENABLED=false
# Schema boundary applied to the prompt and the SQL guard
# ALLOWED_TABLES=["customers","orders"]
# DENIED_COLUMNS=["customers.email","customers.phone"]

# PostgreSQL (docker-compose overrides the host to the postgres service)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Least-privilege role created by db/init/00_roles.sql (Compose and k8s use it too)
POSTGRES_USER=lumina_reader
POSTGRES_PASSWORD=lumina_reader
POSTGRES_DB=lumina
POSTGRES_SCHEMA=public
POSTGRES_SSLMODE=prefer
POSTGRES_STATEMENT_TIMEOUT_MS=15000

# Redis cache (optional; caching is disabled when unset)
# REDIS_URL=redis://localhost:6379/0
SCHEMA_CACHE_TTL_SECONDS=600
QUERY_CACHE_TTL_SECONDS=3600

# AWS / DynamoDB (optional)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# DYNAMODB_ENDPOINT_URL=http://localhost:8001
DYNAMODB_TABLE_PREFIX=
