# Application
LOG_LEVEL=INFO
MAX_RETRY_ITERATIONS=3
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# LLM (set one provider)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=            # optional, for OpenAI-compatible providers
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096

# PostgreSQL (docker-compose overrides the host to the postgres service)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lumina
POSTGRES_SCHEMA=public
POSTGRES_SSLMODE=prefer
POSTGRES_STATEMENT_TIMEOUT_MS=15000

# Redis cache (optional; caching is disabled when unset)
# REDIS_URL=redis://localhost:6379/0
SCHEMA_CACHE_TTL_SECONDS=600
QUERY_CACHE_TTL_SECONDS=3600

# AWS / DynamoDB (optional)
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# DYNAMODB_ENDPOINT_URL=http://localhost:8001
DYNAMODB_TABLE_PREFIX=
