{
  "uid": "lumina-overview",
  "title": "LuminaSQL Agent Overview",
  "tags": [
    "lumina"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests / s",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(lumina_http_requests_total[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "HTTP 5xx ratio",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(lumina_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(lumina_http_requests_total[5m])), 1e-9)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Agent success ratio",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.7
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(lumina_agent_runs_total{outcome!=\"failed\"}[15m])) / clamp_min(sum(rate(lumina_agent_runs_total[15m])), 1e-9)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Query cache hit ratio",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(lumina_cache_requests_total{kind=\"query\",result=\"hit\"}[15m])) / clamp_min(sum(rate(lumina_cache_requests_total{kind=\"query\"}[15m])), 1e-9)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP requests / s by route and status",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route, status) (rate(lumina_http_requests_total[5m]))",
          "legendFormat": "{{route}} {{status}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Agent end-to-end latency",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(lumina_agent_run_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(lumina_agent_run_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Agent outcomes / s",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(lumina_agent_runs_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Avg execution attempts per run",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(lumina_agent_execution_attempts_sum[15m])) / clamp_min(sum(rate(lumina_agent_execution_attempts_count[15m])), 1e-9)",
          "legendFormat": "attempts"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "LLM call latency p95 by phase",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, phase) (rate(lumina_llm_call_duration_seconds_bucket[5m])))",
          "legendFormat": "{{phase}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Database query latency p95",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, backend) (rate(lumina_db_query_duration_seconds_bucket[5m])))",
          "legendFormat": "{{backend}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Database queries / s by status",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (backend, status) (rate(lumina_db_queries_total[5m]))",
          "legendFormat": "{{backend}} {{status}}"
        }
      ]
    },
    {
      "id": 100,
      "type": "row",
      "title": "Reliability and safety",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Failed runs / s by terminal category",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (category) (rate(lumina_agent_run_failures_total[5m]))",
          "legendFormat": "{{category}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Failed attempts / s by category and retry policy",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (category, policy) (rate(lumina_agent_attempt_failures_total[5m]))",
          "legendFormat": "{{category}} ({{policy}})"
        }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Self-correction recovery ratio (1h)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 37
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(lumina_agent_self_correction_total{result=\"recovered\"}[1h])) / clamp_min(sum(increase(lumina_agent_self_correction_total[1h])), 1e-9)"
        }
      ],
      "description": "Share of runs with an LLM-correctable failure that a retry recovered."
    },
    {
      "id": 15,
      "type": "stat",
      "title": "Unsafe rejections by layer (1h)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 37
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (layer) (increase(lumina_unsafe_query_rejections_total[1h]))",
          "legendFormat": "{{layer}}"
        }
      ],
      "description": "layer=database means the validator let something through and the read-only role caught it."
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Transient DB retries / s",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 37
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (category) (rate(lumina_db_transient_retries_total[5m]))",
          "legendFormat": "{{category}}"
        }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "Capacity and backpressure",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "panels": []
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "In-flight vs queued agent requests",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 42
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(lumina_inflight_requests)",
          "legendFormat": "in flight"
        },
        {
          "refId": "B",
          "expr": "sum(lumina_queued_requests)",
          "legendFormat": "queued"
        }
      ]
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Admission queue wait and slot hold (p95)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 42
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(lumina_admission_wait_seconds_bucket[5m])))",
          "legendFormat": "queue wait p95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(lumina_admission_slot_hold_seconds_bucket[5m])))",
          "legendFormat": "slot hold p95"
        }
      ]
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Shed requests / s by reason",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 42
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(lumina_admission_rejections_total[5m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "id": 102,
      "type": "row",
      "title": "LLM usage and cost",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 50
      },
      "panels": []
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "LLM tokens / s by kind",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 51
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(lumina_llm_tokens_total[5m]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Estimated LLM spend (24h)",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 51
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(lumina_llm_estimated_cost_usd_total[24h]))"
        }
      ],
      "description": "Provider-reported tokens times the configured per-token prices; not an invoice."
    },
    {
      "id": 22,
      "type": "stat",
      "title": "Estimated cost per agent run (1h)",
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 51
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 5
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(lumina_llm_estimated_cost_usd_total[1h])) / clamp_min(sum(increase(lumina_agent_runs_total[1h])), 1e-9)"
        }
      ]
    },
    {
      "id": 23,
      "type": "stat",
      "title": "Query cache hit ratio vs LLM calls saved (1h)",
      "gridPos": {
        "h": 4,
        "w": 16,
        "x": 8,
        "y": 55
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(lumina_cache_requests_total{kind=\"query\",result=\"hit\"}[1h]))",
          "legendFormat": "LLM calls saved"
        },
        {
          "refId": "B",
          "expr": "sum(increase(lumina_llm_calls_total[1h]))",
          "legendFormat": "LLM calls made"
        }
      ]
    }
  ]
}
